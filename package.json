{
  "name": "modelport",
  "version": "1.7.9",
  "description": "ModelPort \u6a21\u578b\u6e2f - \u7edf\u4e00\u7ba1\u7406\u591a\u4e2a AI \u670d\u52a1\u63d0\u4f9b\u5546\u4e0e\u8d26\u53f7\u6e20\u9053\uff0c\u63d0\u4f9b OpenAI \u517c\u5bb9 API \u63a5\u53e3",
  "main": "./out/main/index.js",
  "author": {
    "name": "polite0803",
    "url": "https://github.com/polite0803"
  },
  "homepage": "https://github.com/polite0803/ModelPort",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polite0803/ModelPort.git"
  },
  "bugs": {
    "url": "https://github.com/polite0803/ModelPort/issues"
  },
  "keywords": [
    "openai",
    "openai-compatible",
    "api-gateway",
    "llm",
    "ai",
    "proxy",
    "electron",
    "model-routing",
    "load-balancer",
    "typescript"
  ],
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:win": "chcp 65001 && npm run build:channel-pack && electron-vite dev",
    "check:source-artifacts": "node scripts/check-source-artifacts.js",
    "build:channel-pack": "node scripts/build-channel-pack.mjs",
    "build:builtin-catalog": "node scripts/build-builtin-catalog.mjs",
    "build": "npm run check:source-artifacts && npm run build:channel-pack && electron-vite build",
    "gate": "npm run build && npm run build:daemon && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && node scripts/run-tests.mjs \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\" \"tests/**/*.test.js\"",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "start:sandbox": "electron . --no-sandbox",
    "postinstall": "electron-builder install-app-deps",
    "prebuild:check": "node scripts/prebuild-check.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:win32": "npm run build && electron-builder --win --ia32",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac-arm": "npm run build && electron-builder --mac --arm64",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --mac --linux",
    "release": "node scripts/release.js",
    "build:daemon": "node scripts/build-daemon.mjs"
  },
  "dependencies": {
    "@koa/router": "^15.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "conf": "^14.0.0",
    "electron-updater": "^6.3.9",
    "eventsource-parser": "^3.0.6",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-sha3": "^0.9.3",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-ratelimit": "^6.0.0",
    "koa-router": "^12.0.1",
    "lucide-react": "^0.454.0",
    "mime-types": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.28.0",
    "react-window": "^2.2.7",
    "recharts": "^3.7.0",
    "selfsigned": "^2.4.1",
    "tailwind-merge": "^2.5.4",
    "undici": "^6.29.1",
    "zstd-codec": "^0.1.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "canvas": "^3.2.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.modelport.manager",
    "productName": "ModelPort",
    "copyright": "Copyright \u00a9 2026 polite0803",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/channel-pack",
        "to": "channel-pack",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/catalog",
        "to": "catalog",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sha3_wasm_bg.7b9ca65ddd.wasm",
        "to": "sha3_wasm_bg.7b9ca65ddd.wasm"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/electron-updater/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mpc",
        "name": "ModelPort Config",
        "description": "ModelPort \u914d\u7f6e\u6587\u4ef6",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "ModelPort",
        "schemes": [
          "modelport"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ModelPort",
      "license": "LICENSE",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "polite0803",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "ModelPort",
        "Comment": "\u7edf\u4e00\u7ba1\u7406\u591a\u4e2a AI \u670d\u52a1\u63d0\u4f9b\u5546",
        "Categories": "Utility;Network;",
        "StartupWMClass": "modelport"
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "priority": "optional",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
